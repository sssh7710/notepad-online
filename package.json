{
  "name": "notepad-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "copy-to-turso": "node server/copy-to-turso.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
